#!name = NodeSeek签到
#!desc = 捕获浏览器登录请求头并每日自动签到
#!author = 移植自 @Nullwhy / @Curtinp118
#!homepage = https://github.com/ouones/pingme-surge-signin/tree/main/nodeseek
#!loon_version = 3.5.1(983)

[Argument]
enable_cookie = switch,true,tag=抓取登录信息,desc=登录 NodeSeek 后访问个人名片页；收到成功通知后关闭
fixed_legs = switch,false,tag=固定鸡腿,desc=开启固定领取5个；关闭随机领取
cron = input,"0 10 * * *",tag=签到时间,desc=五段 Cron 表达式；默认每天10点

[Script]
request if ${url} ~= /^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\//i then script("https://raw.githubusercontent.com/ouones/pingme-surge-signin/main/nodeseek/NodeSeek-loon.js", "MODE=capture&ENABLE_COOKIE=true") with enable=${enable_cookie}, tag="NodeSeek捕获请求头", timeout=10
cron ${cron} then script("https://raw.githubusercontent.com/ouones/pingme-surge-signin/main/nodeseek/NodeSeek-loon.js", {${fixed_legs}}) with tag="NodeSeek签到", timeout=60

[Mitm]
hostname = www.nodeseek.com
