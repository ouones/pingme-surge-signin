#!name=网络自适应切换
#!desc=当设备在 Wi-Fi 与蜂窝移动网络之间切换时，自动切换指定策略组的选中节点（支持双槽位独立配置）。
#!author=ouones
#!arguments=group1:香港 select,wifi1:🇭🇰 HK-CDT-01,cellular1:🇭🇰 HK-hkcloudx-v6-01,group2:,wifi2:,cellular2:,notify:true
#!arguments-desc=group1: 策略组 1 名称\nwifi1: 策略组 1 在 Wi-Fi 下的目标节点\ncellular1: 策略组 1 在蜂窝网络下的目标节点\ngroup2: 策略组 2 名称（不使用可留空）\nwifi2: 策略组 2 在 Wi-Fi 下的目标节点\ncellular2: 策略组 2 在蜂窝网络下的目标节点\nnotify: 是否在切换时弹出通知 (true/false)
#!category=策略分流

[Script]
网络自适应切换 = type=event, event-name=network-changed, script-path=https://raw.githubusercontent.com/ouones/pingme-surge-signin/main/NetworkSwitch.js, timeout=10, argument="group1={{{group1}}}&wifi1={{{wifi1}}}&cellular1={{{cellular1}}}&group2={{{group2}}}&wifi2={{{wifi2}}}&cellular2={{{cellular2}}}&notify={{{notify}}}"
