#!name=PingMe签到
#!desc=PingMe 自动签到、任务和视频奖励
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!arguments=morning_hour:8,evening_hour:20
#!arguments-desc=设置早晚签到时间（仅填写小时，24 小时制；默认 08:30 和 20:30）

[Script]
PingMe获取签到参数 = type=http-request, pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus, script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js, timeout=60
PingMe签到 = type=cron, cronexp=30 {{{morning_hour}}},{{{evening_hour}}} * * *, script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js, timeout=300, script-update-interval=0

[MITM]
hostname = %APPEND% api.pingmeapp.net
